generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


// my auth models (required by NextAuth)


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // password is nullable — Google OAuth users have no password

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // auth relations
  accounts Account[]
  sessions Session[]

  // app relations
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  comments         Comment[]
  messages         Message[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  taskAttachments  TaskAttachment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}


// my WORKSPACE


model Workspace {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  // slug is the URL-friendly version of the name
  // "My Team" → "my-team"
  // used for routes: /workspace/my-team
  description String?
  logo        String?
  // logo URL stored in Cloudinary

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  members      WorkspaceMember[]
  projects     Project[]
  invitations  Invitation[]
  activityLogs ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id   String        @id @default(cuid())
  role WorkspaceRole @default(DEVELOPER)
  // role controls what this member can do in the workspace

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, workspaceId])
  // one user can only be a member of a workspace once
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        WorkspaceRole    @default(DEVELOPER)
  status      InvitationStatus @default(PENDING)
  token       String           @unique @default(cuid())
  // token is sent in the invite email link

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#2563eb")
  // color for visual identification in the sidebar

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  milestones   Milestone[]
  messages     Message[]
  activityLogs ActivityLog[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Milestone {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      MilestoneStatus @default(UPCOMING)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milestones")
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

// ============================================
// TASKS
// ============================================

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  label       String?
  // label: "bug", "feature", "improvement", "documentation"
  order       Int          @default(0)
  // order controls position within a status column on the kanban board

  dueDate DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // SetNull — if assignee is deleted, task stays but loses assignee

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")
  // self-referential relation — a task can have a parent task (subtask)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  attachments  TaskAttachment[]
  activityLogs ActivityLog[]

  @@map("tasks")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model TaskAttachment {
  id       String @id @default(cuid())
  name     String
  url      String
  // Cloudinary URL
  fileType String
  fileSize Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@map("task_attachments")
}

// ============================================
// TEAM CHAT
// ============================================

model Message {
  id      String @id @default(cuid())
  content String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  body    String
  read    Boolean          @default(false)
  url     String?
  // url to navigate to when notification is clicked

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
  MEMBER_INVITED
  MEMBER_JOINED
  PROJECT_CREATED
  MENTIONED
}

// ============================================
// ACTIVITY LOG
// ============================================

model ActivityLog {
  id     String @id @default(cuid())
  action String
  // "created task", "changed status to Done", "assigned to Sarah"
  entity String
  // "task", "project", "workspace"
  meta   Json?
  // extra data stored as JSON — flexible, no schema needed

  userId String
  user   User   @relation(fields: [userId], references: [id])

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())

  @@map("activity_logs")
}